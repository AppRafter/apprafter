<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  The polkit actions AppRafter Desktop asks for (apprafter-os-auth, src/linux/polkit.rs).
  The deb and rpm packages install it into /usr/share/polkit-1/actions/ (bundle.linux in
  src-tauri/tauri.conf.json5); without it the app reports PolicyMissing and falls back to PAM.

  auth_self: the user proves it is them with their own password, never an administrator's
  (auth_admin), and never with a grant kept for minutes afterwards (auth_self_keep). Nothing
  is allowed without an active local session.
-->
<policyconfig>
  <vendor>AppRafter</vendor>
  <vendor_url>https://apprafter.dev</vendor_url>
  <action id="dev.apprafter.desktop.unlock">
    <description>Unlock AppRafter Desktop</description>
    <message>Authentication is required to unlock AppRafter Desktop</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_self</allow_active></defaults>
  </action>
  <action id="dev.apprafter.desktop.confirm">
    <description>Confirm an AppRafter operation</description>
    <message>Authentication is required to approve or run a destructive AppRafter operation</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_self</allow_active></defaults>
  </action>
</policyconfig>
