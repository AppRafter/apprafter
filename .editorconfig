root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yaml,yml,json,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{rs}]
indent_size = 4

[*.cue]
indent_size = 4

[Makefile]
indent_style = tab

[*.{nix}]
indent_size = 2
