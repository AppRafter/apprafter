package v1alpha1

// ResourceClaim is generated by the Application operator when an
// Application declares a `need`. It is routed to a matching
// ServiceProvider via labels.
//
// Operator-only resource: admission rejects user-created claims
// (the operator generates them in 2.4). `status` (provider,
// connectionSecretRef, ready, conditions) is the controller's report
// surface — schema only here; the reconciler that writes it lands
// in 2.3.
#ResourceClaim: {
	#TypeMeta
	kind:     "ResourceClaim"
	metadata: #ObjectMeta
	spec: {
		type: #PlatformServiceType
		selector: [string]: string
		size?: #Size
	}

	status?: {
		provider?:            string
		connectionSecretRef?: string
		ready?:               bool
		// Controller-reported conditions. Read-only schema in 2.2;
		// the reconciler that writes them lands in 2.3. Mirrors the
		// condition shape used by the other CRDs.
		conditions?: [...#ResourceClaimCondition]
	}
}

#ResourceClaimCondition: {
	type:               string
	status:             "True" | "False" | "Unknown"
	reason?:            string
	message?:           string
	lastTransitionTime: string
}
