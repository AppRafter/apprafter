# Copy to .env (or .env.local) to override defaults.
# All vars are optional — defaults match local single-machine dev.

# Astro dev-server port (`bun run dev`). Default: 4321.
LANDING_WEB_PORT=4321

# Astro preview-server port (`bun run preview`). Default: 4322.
LANDING_WEB_PREVIEW_PORT=4322

# Where the Astro dev-server proxies /api/* requests. The default
# derives from LANDING_CMS_PORT (3000) — change that to keep web
# and cms in sync. Override LANDING_CMS_URL directly when Payload
# is behind a reverse proxy during local dev (Caddy, ngrok, etc.).
LANDING_CMS_PORT=3000
# LANDING_CMS_URL=http://localhost:3000

# Browser-side URL of the CMS — used by waitlist form and any other
# runtime fetches. Leave empty in dev to use the Vite proxy via
# relative /api/* paths; set explicitly in production builds.
# PUBLIC_CMS_URL=https://cms.apprafter.dev
