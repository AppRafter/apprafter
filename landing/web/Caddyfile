# Minimal Caddy config baked into the landing-web container image.
# The container exposes :80; the outer Caddy on the host adds TLS
# and the public hostname (see landing/DEPLOY.md).
#
# Trailing-slash + extensionless URLs (`/privacy` and `/privacy/`
# both resolve) are handled by `try_files`; missing routes serve
# the prebuilt 404 page so the SPA-style flow stays consistent
# between the in-cluster pod and a direct `caddy file_server`.

:80 {
	root * /usr/share/caddy
	file_server
	encode gzip zstd

	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header / Cache-Control "public, max-age=3600"

	# Icons + OG image are referenced with a content-hash ?v= query
	# (see src/lib/asset-version.ts), so a changed file always gets a
	# fresh URL. A 1-day TTL keeps direct/probe hits on the bare path
	# reasonably fresh instead of inheriting Cloudflare's 4h default.
	@icons path /favicon.ico /favicon.svg /favicon-16.png /apple-touch-icon.png /og-image.png
	header @icons Cache-Control "public, max-age=86400"

	try_files {path} {path}/ /404.html

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
