---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Terms stub. Replaced by a Payload-driven LegalPages
// collection when the real document ships.

import BaseLayout from '../components/layout/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Container from '../components/primitives/Container.astro';
import { getLegalTerms } from '../lib/cms';

const page = await getLegalTerms();
---

<BaseLayout title={page.seoTitle} description={page.seoDescription}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <Header />
  <main id="main">
    <Container>
      <article class="legal">
        <p class="eyebrow" style="margin-top: 64px;">{page.eyebrow}</p>
        <h1>{page.heading}</h1>

        <div set:html={page.bodyHtml} />
      </article>
    </Container>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal {
    max-width: 720px;
    padding-bottom: 96px;
  }
  .legal h1 {
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: 16px;
  }
  .legal :global(.lede) {
    margin-top: 24px;
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.55;
  }
  .legal :global(h2) {
    margin-top: 48px;
    font-size: 22px;
  }
  .legal :global(p) {
    margin-top: 16px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .legal :global(p strong) {
    color: var(--fg);
    font-weight: 500;
  }
  .legal :global(a) {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .legal :global(a:hover) {
    border-bottom-color: var(--accent);
  }
  .legal :global(.closing) {
    margin-top: 56px;
    font-style: italic;
    color: var(--fg-faint);
  }
</style>
