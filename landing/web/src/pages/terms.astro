---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Terms stub. Replaced by a Payload-driven LegalPages
// collection when the real document ships.

import BaseLayout from '../components/layout/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Container from '../components/primitives/Container.astro';
---

<BaseLayout
  title="Terms — AppRafter"
  description="AppRafter terms of use. License is FSL-1.1-Apache-2.0; full text in repo."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <Header />
  <main id="main">
    <Container>
      <article class="legal">
        <p class="eyebrow" style="margin-top: 64px;">/ Legal</p>
        <h1>Terms.</h1>

        <p class="lede">
          AppRafter the open-source project is governed by its
          <a
            href="https://github.com/AppRafter/apprafter/blob/main/LICENSE"
            target="_blank"
            rel="noreferrer">LICENSE</a>
          (FSL-1.1-Apache-2.0 — see
          <a
            href="https://github.com/AppRafter/apprafter/blob/main/docs/adr/0032-license-fsl-1-1-apache-2-0.md"
            target="_blank"
            rel="noreferrer">ADR 0032</a>).
          This page covers terms specific to
          <a href="/">apprafter.dev</a>.
        </p>

        <h2>The site</h2>
        <p>
          apprafter.dev is informational. No accounts, no purchases, no
          contracts are signed by browsing it. The site is provided
          “as is” without warranty.
        </p>

        <h2>The software</h2>
        <p>
          The platform code (cli, operator, schemas, manifests,
          platform services) is licensed under <strong>FSL-1.1-Apache-2.0</strong>
          and converts to plain Apache 2.0 two years after each release.
          You may use it for any purpose — personal, internal business,
          or commercial workloads — <em>except</em> offering AppRafter
          itself as a managed service to third parties during the FSL
          window. After two years, that restriction lifts.
        </p>

        <h2>The waitlist</h2>
        <p>
          Submitting the managed-launch waitlist form is not a contract.
          We send exactly one announcement email when the managed
          offering ships, plus one optional follow-up if you ticked the
          discovery-call box. You can ask us to delete the entry any
          time at <a href="mailto:hello@apprafter.dev">hello@apprafter.dev</a>.
        </p>

        <p class="closing">
          When the formal terms ship they will replace this stub. The
          source of truth will move to a Payload <code class="mono">LegalPages</code>
          collection.
        </p>
      </article>
    </Container>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal {
    max-width: 720px;
    padding-bottom: 96px;
  }
  .legal h1 {
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: 16px;
  }
  .legal .lede {
    margin-top: 24px;
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.55;
  }
  .legal h2 {
    margin-top: 48px;
    font-size: 22px;
  }
  .legal p {
    margin-top: 16px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .legal p strong {
    color: var(--fg);
    font-weight: 500;
  }
  .legal a {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .legal a:hover {
    border-bottom-color: var(--accent);
  }
  .legal .closing {
    margin-top: 56px;
    font-style: italic;
    color: var(--fg-faint);
  }
</style>
