---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Bootstrap stub — replaced by the real composition in Phase G.
// For Phase C we exercise the new primitives so a single build verifies
// the LogoMark / Wordmark / Brand / Container / SectionHead / StatusPill
// chain plus the ThemeToggle Svelte island.

import { THEME_INIT_SCRIPT } from '../lib/theme-init';
import '../styles/index.css';
import Brand from '../components/brand/Brand.astro';
import Container from '../components/primitives/Container.astro';
import SectionHead from '../components/primitives/SectionHead.astro';
import StatusPill from '../components/primitives/StatusPill.astro';
import ThemeToggle from '../components/layout/ThemeToggle.svelte';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AppRafter — primitives preview</title>
    <link
      rel="preload"
      href="/fonts/roboto-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>

    <Container as="header" class="bootstrap-header">
      <Brand variant="twoTone" size={26} />
      <ThemeToggle client:load />
    </Container>

    <main id="main">
      <Container as="section" class="bootstrap-section">
        <SectionHead
          eyebrow="Phase C preview"
          title="Primitives wired."
          lede="LogoMark + Wordmark + Brand link, Container, SectionHead, three StatusPill kinds, and the ThemeToggle Svelte island."
        />

        <div class="pill-row">
          <StatusPill kind="live" label="Available now" />
          <StatusPill kind="waitlist" label="Waitlist" />
          <StatusPill kind="roadmap" label="Roadmap" />
        </div>

        <p class="muted" style="margin-top: 32px; max-width: 36rem;">
          Click the sun / moon icon in the header to verify theme switching
          persists across reloads. The real hero, sections, and footer arrive
          in Phase D through G.
        </p>
      </Container>
    </main>

    <style>
      .bootstrap-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        border-bottom: 1px solid var(--border);
      }
      .bootstrap-section {
        padding-top: var(--section-pad-y);
      }
      .pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }
    </style>
  </body>
</html>
