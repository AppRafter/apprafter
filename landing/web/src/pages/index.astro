---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Bootstrap stub — replaced by the real composition in Phase G.
// For Phase E it wires the Hero (with CUE snippet + waitlist) into
// the existing Header + Footer chain so a single build verifies
// the whole top-of-page surface end-to-end.

import '../styles/index.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/hero/Hero.astro';
import { THEME_INIT_SCRIPT } from '../lib/theme-init';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AppRafter — One manifest. From a €5 VPS to production. Open source.</title>
    <meta
      name="description"
      content="AppRafter is an opinionated PaaS on Kubernetes. Describe your applications in a single CUE manifest — the same one runs from a single VDS to a multi-node production cluster. Open source (FSL-1.1-Apache-2.0)."
    />
    <link
      rel="preload"
      href="/fonts/roboto-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>

    <Header />

    <main id="main">
      <Hero />
    </main>

    <Footer />
  </body>
</html>
