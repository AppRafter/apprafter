import BaseLayout from '../components/layout/BaseLayout.astro';
import Brand from '../components/brand/Brand.astro';
import Container from '../components/primitives/Container.astro';
import { getNotFound } from '../lib/cms';

const page = await getNotFound();
---

<BaseLayout title={page.seoTitle} description={page.seoDescription}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <main id="main">
    <Container>
      <div class="wrap">
        <Brand variant="twoTone" size={28} />
        <p class="eyebrow" style="margin-top: 48px;">{page.eyebrow}</p>
        <h1>{page.heading}</h1>
        <p class="lede" set:html={page.bodyHtml} />
      </div>
    </Container>
  </main>
</BaseLayout>

<style>
  .wrap {
    padding-top: 96px;
    padding-bottom: 160px;
    max-width: 680px;
  }
  h1 {
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: 16px;
  }
  .lede {
    margin-top: 24px;
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.55;
    max-width: 560px;
  }
  .lede :global(a) {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .lede :global(a:hover) {
    border-bottom-color: var(--accent);
  }
</style>
