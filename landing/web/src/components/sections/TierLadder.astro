import { getTierLadder } from '../../lib/cms';
import Container from '../primitives/Container.astro';
import SectionHead from '../primitives/SectionHead.astro';

const data = await getTierLadder();
const cards = data.cards ?? [];
---

<section aria-label="Tier ladder" id="tiers" data-screen-label="tiers">
  <Container>
    <SectionHead eyebrow={data.eyebrow} title={data.title} />
    <div class="ladder-wrap">
      <div class="stair" aria-hidden="true">
        {
          [1, 2, 3, 4].map((n) => (
            <div class={`step${n <= 1 ? ' live' : ''}`} style={`height: ${20 + n * 16}px`}>
              <span class="label">T{n}</span>
            </div>
          ))
        }
      </div>
      <div class="tier-cards">
        {
          cards.map((t) => (
            <div class="tier-card">
              <span class="tier-num">{t.num}</span>
              <h3>{t.title}</h3>
              <div class="price">{t.price}</div>
              <p>{t.desc}</p>
              <span class={`status ${t.status}`}>{t.statusText}</span>
              {t.status !== 'live' && (
                <button
                  type="button"
                  class="tier-waitlist btn-waitlist"
                  data-preselect={t.num === 'Tier 2' ? 'tier2' : t.num === 'Tier 3' ? 'tier3' : 'tier4'}
                >
                  Join the waitlist
                </button>
              )}
            </div>
          ))
        }
      </div>
      <div class="orthogonal-note" set:html={data.orthogonalNoteHtml} />
    </div>
  </Container>
</section>

<script>
  for (const b of document.querySelectorAll('.tier-waitlist')) {
    b.addEventListener('click', () => {
      const preselect = (b as HTMLElement).dataset.preselect;
      document.dispatchEvent(
        new CustomEvent('waitlist:toggle', { detail: { open: true, preselect } }),
      );
    });
  }
</script>

<style>
  .ladder-wrap {
    position: relative;
    margin-top: 8px;
  }
  .tier-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 56px;
  }
  .tier-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 24px 22px 26px;
    display: flex;
    flex-direction: column;
    min-height: 280px;
  }
  .tier-card .tier-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--fg-faint);
    text-transform: uppercase;
  }
  .tier-card h3 {
    margin-top: 10px;
    font-size: 20px;
    font-weight: 700;
  }
  .tier-card .price {
    margin-top: 6px;
    font-size: 14px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .tier-card p {
    margin-top: 14px;
    font-size: 14.5px;
    color: var(--fg-muted);
    line-height: 1.55;
    flex-grow: 1;
  }
  .tier-card .status {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 6px 9px;
    border: 1px solid var(--border-strong);
    color: var(--fg-muted);
  }
  .tier-card .status.live {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tier-card .status.live::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent);
    display: inline-block;
  }
  .tier-card .status.roadmap::before {
    content: '';
    width: 6px;
    height: 6px;
    border: 1px solid var(--fg-faint);
    display: inline-block;
  }
  .tier-card .btn-waitlist {
    margin-top: 12px;
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 8px 12px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    border-radius: 4px;
    transition: border-color 150ms ease;
  }
  .tier-card .btn-waitlist:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .stair {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 88px;
    align-items: end;
    margin-top: 48px;
    gap: 16px;
    position: relative;
  }
  .stair .step {
    position: relative;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
  }
  .stair .step.live {
    background: var(--surface);
    border-color: var(--accent);
  }
  .stair .step .label {
    position: absolute;
    bottom: 8px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stair .step.live .label {
    color: var(--accent);
  }

  .orthogonal-note {
    margin-top: 32px;
    padding: 18px 22px;
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--surface));
    font-size: 15px;
    color: var(--fg-muted);
  }
  .orthogonal-note :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }

  @media (max-width: 1080px) {
    .tier-cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .stair {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .tier-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
