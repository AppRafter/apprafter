import { getAdvantages } from '../../lib/cms';
import Container from '../primitives/Container.astro';
import SectionHead from '../primitives/SectionHead.astro';

const data = await getAdvantages();
const blocks = data.blocks ?? [];
---

<section aria-label="Structural advantages" id="architecture" data-screen-label="architecture">
  <Container>
    <SectionHead eyebrow={data.eyebrow} title={data.title} lede={data.lede} />
    <div class="advantages">
      {
        blocks.map((b) => (
          <div class={`advantage${b.featured ? ' advantage-featured' : ''}`}>
            <h3>{b.title}</h3>
            <p set:html={b.leadHtml} />
            <p class="faint italic" style="font-size: 14px;">
              {b.detail}
            </p>
            <span class="phase-tag">{b.phaseTag}</span>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .advantages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: 0;
    margin-top: 56px;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }
  .advantage {
    padding: 36px 40px 40px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    position: relative;
    display: flex;
    flex-direction: column;
    align-self: stretch;
  }
  .advantage h3 {
    font-size: 21px;
    margin-bottom: 14px;
    max-width: 90%;
    text-wrap: balance;
  }
  .advantage h3 strong {
    font-weight: 700;
  }
  .advantage p {
    font-size: 15px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .advantage p + p {
    margin-top: 12px;
  }
  .advantage > p:nth-of-type(2) {
    margin-top: auto;
    padding-top: 12px;
  }
  .advantage .phase-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    padding: 5px 9px;
    border: 1px solid var(--border-strong);
    align-self: flex-start;
  }
  .advantage .italic {
    font-style: italic;
  }
  .advantage p :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }
  .advantage p :global(code.mono) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 1px 4px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--accent);
  }

  .advantage-featured {
    grid-column: 1 / -1;
    background: color-mix(in srgb, var(--accent) 4%, var(--surface));
  }
  .advantage-featured h3 {
    max-width: 60%;
  }
  .advantage-featured > p:first-of-type {
    max-width: 78%;
  }

  @media (max-width: 1080px) {
    .advantages {
      grid-template-columns: 1fr;
    }
    .advantage-featured h3,
    .advantage-featured > p:first-of-type {
      max-width: 100%;
    }
  }
</style>
