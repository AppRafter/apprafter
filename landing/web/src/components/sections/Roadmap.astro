import { getRoadmap } from '../../lib/cms';
import Container from '../primitives/Container.astro';
import SectionHead from '../primitives/SectionHead.astro';

const data = await getRoadmap();
const phases = data.phases ?? [];

const slug = (num: string) =>
  `roadmap-phase-${num.toLowerCase().replace(/\W+/g, '-').replace(/^-|-$/g, '')}`;
---

<section aria-label="Roadmap" id="roadmap" data-screen-label="roadmap">
  <Container>
    <SectionHead eyebrow={data.eyebrow} title={data.title} lede={data.lede} />
    <div class="roadmap">
      {
        phases.map((p) => (
          <div class="roadmap-phase" id={slug(p.num)}>
            <div class="phase-meta">
              <div class="phase-num">{p.num}</div>
              <h3>{p.title}</h3>
            </div>
            <ul>
              {(p.items ?? []).map((item) => (
                <li>{item.text}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="roadmap-closing">{data.closing}</p>
  </Container>
</section>

<style>
  .roadmap {
    margin-top: 48px;
    position: relative;
  }
  .roadmap-phase {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 56px;
    padding: 36px 0;
    border-top: 1px solid var(--border);
    position: relative;
  }
  .roadmap-phase:last-child {
    border-bottom: 1px solid var(--border);
  }
  .roadmap-phase .phase-meta {
    position: sticky;
    top: 88px;
    align-self: start;
  }
  .roadmap-phase .phase-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .roadmap-phase h3 {
    font-size: 24px;
    margin-top: 8px;
    text-wrap: balance;
  }
  .roadmap-phase ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .roadmap-phase li {
    font-size: 16px;
    color: var(--fg-muted);
    padding-left: 22px;
    position: relative;
    line-height: 1.5;
  }
  .roadmap-phase li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 1px;
    background: var(--accent);
  }
  .roadmap-closing {
    margin-top: 56px;
    font-size: 17px;
    color: var(--fg-muted);
    max-width: 720px;
    line-height: 1.6;
  }

  @media (max-width: 1080px) {
    .roadmap-phase {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .roadmap-phase .phase-meta {
      position: static;
    }
  }
</style>
