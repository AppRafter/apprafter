---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0

import phaseRegistry from '../../data/phases.json';
import { getRoadmap } from '../../lib/cms';
import { phaseAnchor } from '../../lib/phase-anchor';
import Container from '../primitives/Container.astro';
import SectionHead from '../primitives/SectionHead.astro';

const data = await getRoadmap();
const phases = data.phases ?? [];

// Map each roadmap block's display label (p.num, e.g. "Phase 3") to
// the registry entry so the anchor derives from the stable id, not the
// label. Falls back to the label if a block has no registry twin.
//
// NORMALISED, because the join is by display label and a display label
// is the half that moves. The `+` suffix was removed from the registry
// and from every tracked fallback, but the live CMS is edited by hand
// and lags: a block still reading `Phase 5+` missed the registry
// entirely, `anchorFor` fell back to slugifying the label — the doubled
// prefix R2 removed, which the smoke test still guards against by name
// — and the notify button, gated on the same lookup, was skipped
// too. Every inbound link to that phase then pointed at an id the page
// did not emit. Tolerating the variant costs one `replace`; not
// tolerating it costs a broken anchor on production until someone edits
// a CMS field by hand.
const normalise = (label: string) => label.trim().replace(/\+$/, '');
const byLabel = new Map(phaseRegistry.phases.map((e) => [normalise(e.label), e]));
const entryFor = (num: string) => byLabel.get(normalise(num));
const anchorFor = (num: string) => phaseAnchor(entryFor(num)?.id ?? num);
---

<section aria-label="Roadmap" id="roadmap" data-screen-label="roadmap">
  <Container>
    <SectionHead eyebrow={data.eyebrow} title={data.title} lede={data.lede} />
    <div class="roadmap">
      {
        phases.map((p) => (
          <div class="roadmap-phase" id={anchorFor(p.num)}>
            <div class="phase-meta">
              <div class="phase-num">{p.num}</div>
              <h3>{p.title}</h3>
            </div>
            <div class="phase-body">
              <ul>
                {(p.items ?? []).map((item) => (
                  <li>{item.text}</li>
                ))}
              </ul>
              {entryFor(p.num) && entryFor(p.num)!.status !== 'shipped' && (
                <button
                  type="button"
                  class="roadmap-waitlist"
                  data-preselect={entryFor(p.num)!.id}
                >
                  Get notified when {entryFor(p.num)!.label} ships
                </button>
              )}
            </div>
          </div>
        ))
      }
    </div>
    <p class="roadmap-closing">{data.closing}</p>
    <!-- In the component rather than in `data.closing`: the closing line
         is CMS content, so a link living there would not exist until
         someone edited production. This one ships with the code. -->
    <p class="roadmap-status">
      Every feature, its status and the phase it lands in:
      <a href="https://docs.apprafter.dev/status/">the feature status page</a>.
    </p>
  </Container>
</section>

<script>
  for (const b of document.querySelectorAll('.roadmap-waitlist')) {
    b.addEventListener('click', () => {
      const preselect = (b as HTMLElement).dataset.preselect;
      document.dispatchEvent(
        new CustomEvent('waitlist:toggle', { detail: { open: true, preselect } }),
      );
    });
  }
</script>

<style>
  .roadmap {
    margin-top: 48px;
    position: relative;
  }
  .roadmap-phase {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 56px;
    padding: 36px 0;
    border-top: 1px solid var(--border);
    position: relative;
  }
  .roadmap-phase:last-child {
    border-bottom: 1px solid var(--border);
  }
  .roadmap-phase .phase-meta {
    position: sticky;
    top: 88px;
    align-self: start;
  }
  /* The deliverables and the subscribe button are ONE grid item.
     Without this wrapper the button auto-places into row 2 / column 1 —
     the column the sticky heading travels down — and because a sticky
     box is positioned while the button is static, the heading paints
     over it on scroll. `z-index` would hide that collision without
     removing it, and would leave the button in the wrong column.
     `min-width: 0` lets the column shrink so a long list item can still
     wrap rather than forcing the grid wider. */
  .roadmap-phase .phase-body {
    min-width: 0;
  }
  .roadmap-phase .phase-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .roadmap-phase h3 {
    font-size: 24px;
    margin-top: 8px;
    text-wrap: balance;
  }
  .roadmap-phase ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .roadmap-phase li {
    font-size: 16px;
    color: var(--fg-muted);
    padding-left: 22px;
    position: relative;
    line-height: 1.5;
  }
  .roadmap-phase li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 1px;
    background: var(--accent);
  }
  .roadmap-waitlist {
    /* No `justify-self`: inside `.phase-body` this is a block-level
       child, and a <button> is shrink-to-fit, so it already hugs its
       label. The declaration was there to stop it filling a grid track
       it is no longer in. */
    display: block;
    margin-top: 20px;
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 8px 12px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    border-radius: 4px;
    transition: border-color 150ms ease;
  }
  .roadmap-waitlist:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .roadmap-status {
    margin-top: 20px;
    font-size: 15px;
    color: var(--fg-muted);
    max-width: 720px;
  }
  .roadmap-status a {
    color: var(--accent);
  }
  .roadmap-closing {
    margin-top: 56px;
    font-size: 17px;
    color: var(--fg-muted);
    max-width: 720px;
    line-height: 1.6;
  }

  @media (max-width: 1080px) {
    .roadmap-phase {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .roadmap-phase .phase-meta {
      position: static;
    }
  }
</style>
