---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0

import { getComparison, getTransparency } from '../../lib/cms';
import Container from '../primitives/Container.astro';
import SectionHead from '../primitives/SectionHead.astro';
import StatusPill from '../primitives/StatusPill.astro';

const data = await getComparison();
const transparency = await getTransparency();

const rows = data.rows ?? [];
const cols = data.columns;
const blocks = transparency.blocks ?? [];

type Kind = 'live' | 'waitlist' | 'roadmap';
const safeKind = (k: string | null | undefined): Kind =>
  k === 'waitlist' || k === 'roadmap' ? k : 'live';
---

<section aria-label="Self-host vs Managed vs Turnkey" id="offerings" data-screen-label="offerings">
  <Container>
    <SectionHead eyebrow={data.eyebrow} title={data.title} />

    <table class="compare-table">
      <thead>
        <tr>
          <th scope="col"></th>
          <th scope="col">{cols?.self?.label}</th>
          <th scope="col" class="featured">
            {cols?.managed?.label}
            {cols?.managed?.badgeSuffix && (
              <span class="mono faint" style="font-size: 11px; margin-left: 6px;">
                {cols.managed.badgeSuffix}
              </span>
            )}
          </th>
          <th scope="col">
            {cols?.turnkey?.label}
            {cols?.turnkey?.badgeSuffix && (
              <span class="mono faint" style="font-size: 11px; margin-left: 6px;">
                {cols.turnkey.badgeSuffix}
              </span>
            )}
          </th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td>{r.label}</td>
              <td set:html={r.selfHtml} />
              <td set:html={r.managedHtml} />
              <td set:html={r.turnkeyHtml} />
            </tr>
          ))
        }
        <tr class="status-row">
          <td>{data.statusRowLabel}</td>
          <td>
            <StatusPill
              kind={safeKind(cols?.self?.statusKind)}
              label={cols?.self?.statusLabel ?? ''}
            />
          </td>
          <td>
            <button type="button" class="managed-waitlist">{data.managedWaitlistButtonLabel}</button>
          </td>
          <td>
            <StatusPill
              kind={safeKind(cols?.turnkey?.statusKind)}
              label={cols?.turnkey?.statusLabel ?? ''}
            />
          </td>
        </tr>
      </tbody>
    </table>

    <p class="footnote" set:html={data.footnoteHtml} />

    <div class="transparency-grid">
      {
        blocks.map((b) => (
          <div class="transparency-card">
            <h4>
              <span class="kicker">{b.kicker}</span>
              {b.title}
            </h4>
            <div set:html={b.bodyHtml} />
          </div>
        ))
      }
    </div>
  </Container>
<script>
  for (const b of document.querySelectorAll('.managed-waitlist')) {
    b.addEventListener('click', () => {
      document.dispatchEvent(
        new CustomEvent('waitlist:toggle', { detail: { open: true, preselect: 'managed' } }),
      );
    });
  }
</script>
</section>

<style>
  /* The Managed column has no static "Waitlist" pill — the button IS the
     pill, so it lines up with the Self/Turnkey status pills on the same
     row. Box model mirrors StatusPill.astro `.status-pill.is-waitlist`
     (140x28, accent outline + leading 5px square) so every cell's badge
     sits at the same height and width. */
  .managed-waitlist {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 140px;
    height: 28px;
    padding: 6px 12px;
    box-sizing: border-box;
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .managed-waitlist::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--accent);
  }
  .managed-waitlist:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 16px;
    font-size: 14.5px;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    vertical-align: top;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
  }
  .compare-table thead th {
    font-weight: 700;
    font-size: 16px;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 24px;
    padding-top: 24px;
    position: relative;
  }
  .compare-table thead th.featured {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    border-bottom-color: var(--accent);
  }
  .compare-table tbody tr:hover td {
    background: color-mix(in srgb, var(--fg) 2%, transparent);
  }
  .compare-table tbody td:first-child {
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    width: 200px;
    padding-top: 22px;
  }

  .compare-table :global(.price-cell) {
    font-weight: 500;
    color: var(--fg);
  }
  .compare-table :global(.price-cell .price-sub) {
    display: block;
    font-size: 13px;
    color: var(--fg-muted);
    font-weight: 400;
    margin-top: 4px;
  }

  .compare-table .status-row td:first-child {
    color: transparent;
    padding-top: 18px;
  }
  .compare-table .status-row td:not(:first-child) {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footnote {
    margin-top: 18px;
    font-size: 13px;
    color: var(--fg-faint);
    font-style: italic;
    max-width: 880px;
    line-height: 1.55;
  }
  .footnote :global(sup) {
    color: var(--accent);
    font-style: normal;
    font-weight: 500;
  }

  .transparency-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: 24px;
    margin-top: 56px;
  }
  .transparency-card {
    padding: 28px 28px 32px;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 320px;
  }
  .transparency-card h4 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 14px;
    letter-spacing: -0.005em;
    min-height: 64px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .transparency-card h4 .kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 6px;
  }
  .transparency-card :global(p) {
    font-size: 14.5px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .transparency-card :global(p + p) {
    margin-top: 12px;
  }
  .transparency-card :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }
  .transparency-card :global(code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 1px 6px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--accent);
  }

  @media (max-width: 1080px) {
    .compare-table tbody td:first-child {
      width: 150px;
    }
  }
  @media (max-width: 720px) {
    .transparency-grid {
      grid-template-columns: 1fr;
    }
    .transparency-card {
      min-height: 0;
    }
    .compare-table thead {
      display: none;
    }
    .compare-table,
    .compare-table tbody,
    .compare-table tr,
    .compare-table td {
      display: block;
      width: 100%;
    }
    .compare-table tr {
      border: 1px solid var(--border);
      margin-bottom: 16px;
      padding: 12px;
    }
    .compare-table td {
      padding: 8px 0;
      border-bottom: 1px dashed var(--border);
    }
    .compare-table tbody td:first-child {
      width: auto;
      padding-top: 8px;
    }
  }
</style>
