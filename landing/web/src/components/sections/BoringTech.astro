import { getBoringTech } from '../../lib/cms';
import Container from '../primitives/Container.astro';
import SectionHead from '../primitives/SectionHead.astro';

const data = await getBoringTech();
const underHood = data.underHood ?? [];
const ourCode = data.ourCode ?? [];
---

<section aria-label="Boring tech" id="stack" data-screen-label="stack">
  <Container>
    <SectionHead eyebrow={data.eyebrow} title={data.title} lede={data.lede} />
    <div class="boring-grid">
      <div class="boring-col">
        <h3>Under the hood</h3>
        <ul class="tech-list">
          {
            underHood.map((item) => (
              <li>
                <span class="name">{item.name}</span>
                <span class="desc">{item.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="boring-col">
        <h3>What we wrote ourselves</h3>
        <ul class="tech-list">
          {
            ourCode.map((item) => (
              <li>
                <span class="name">
                  <span class="ours">{item.name}</span>
                </span>
                <span class="desc">{item.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="closing" set:html={data.closingHtml} />
  </Container>
</section>

<style>
  .boring-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    margin-top: 56px;
  }
  .boring-col h3 {
    font-size: 14px;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .tech-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tech-list li {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14.5px;
  }
  .tech-list li:last-child {
    border-bottom: 0;
  }
  .tech-list .name {
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 13.5px;
    letter-spacing: -0.005em;
    color: var(--fg);
  }
  .tech-list .name .ours {
    color: var(--accent);
  }
  .tech-list .desc {
    color: var(--fg-muted);
    line-height: 1.55;
  }

  .closing {
    font-size: 17px;
    color: var(--fg-muted);
    max-width: 760px;
    line-height: 1.6;
    margin-top: 56px;
  }
  .closing :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }

  @media (max-width: 1080px) {
    .boring-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 720px) {
    .tech-list li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
