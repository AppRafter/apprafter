//
// Small uppercase mono kicker used above section titles.
// Renders the leading slash automatically — pass the label only,
// e.g. <Eyebrow text="Why AppRafter" /> renders "/ WHY APPRAFTER".

type Props = {
  text: string;
};

const { text } = Astro.props;
---

<div class="eyebrow">/ {text}</div>
