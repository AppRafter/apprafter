---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Hero section. Left column: headline + subhead + three CTAs +
// status badge + (lazily expanded) WaitlistForm. Right column:
// HeroCodeBlock with the canonical Application.cue. Phase H wires
// the copy + CTAs to Payload's LandingHero global; for now copy
// is hardcoded from sections.jsx (the design source-of-truth).

import Container from '../primitives/Container.astro';
import HeroCodeBlock from './HeroCodeBlock.astro';
import WaitlistForm from './WaitlistForm.svelte';

// Per Q7 (2026-05-22): badge starts at "v0.3 · Phase 3 · ...",
// rest matches the design copy.
const statusBadge = 'v0.3 · Phase 3 · MVP shipped on Tier 1 and Tier 2 · managed in development';

const primary = {
  label: 'Try self-host',
  href: 'https://github.com/AppRafter/apprafter#quickstart',
};
const tertiary = {
  label: 'View on GitHub',
  href: 'https://github.com/AppRafter/apprafter',
};

const cueFilename = 'billing-api.cue';
const cueSnippet = `apiVersion: apprafter.io/v1alpha1
kind: Application
metadata: {
    name:      "billing-api"
    namespace: "prod"
}

spec: {
    base: {
        image:    "ghcr.io/me/billing:v1.4.2"
        replicas: 3

        expose: {
            port:    8080
            public:  true
            network: "public"
        }

        needs: {
            pg: {size: "small"}
        }

        env: {
            DATABASE_URL: from: claim.pg.uri
            LOG_LEVEL:    "info"
        }
    }

    environments: {
        dev:  base & {replicas: 1, expose: network: "vpn"}
        prod: base & {replicas: 3}
    }
}`;

// Waitlist copy — hardcoded for Phase E; moves to Payload
// WaitlistFormCopy global in Phase H.
const waitlistCopy = {
  formIntro:
    "The managed version of AppRafter is in development. Drop your email — we'll let you know when it's ready. One email, no newsletter, no marketing drip.",
  emailLabel: 'Email',
  useCaseLabel: "What's your use case? (optional)",
  callLabel: "I'd like a short call to discuss my use case.",
  submitLabel: 'Notify me',
  successMessage: "→ We'll be in touch.",
  successWithCall:
    "→ We'll be in touch. You'll get a separate email with a calendar link.",
  storageNote: 'Stored only for launch announcement.',
};
---

<section class="hero" aria-label="Hero">
  <Container class="hero-grid">
    <div>
      <h1>
        One manifest. From a <span class="accented">€5 VPS</span> to production.
        Open source.
      </h1>
      <p class="subhead">
        AppRafter is an opinionated PaaS on Kubernetes. Describe your
        applications in a single CUE manifest — the same one runs from a
        single VDS to a multi-node production cluster. Open source
        (FSL-1.1-Apache-2.0). A managed version is coming for those who'd
        rather not run ops themselves.
      </p>

      <div class="ctas">
        <a
          class="btn btn-primary"
          href={primary.href}
          target="_blank"
          rel="noreferrer"
        >
          {primary.label}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>

        <button
          id="waitlist-toggle"
          class="btn btn-secondary"
          type="button"
          aria-controls="waitlist-form"
          aria-expanded="false"
        >
          Notify me on managed launch
        </button>

        <a class="btn btn-text" href={tertiary.href} target="_blank" rel="noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5A12 12 0 0 0 0 12.5a12 12 0 0 0 8.2 11.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.7 1 .1-.8.4-1.4.8-1.7-2.6-.3-5.4-1.3-5.4-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.3 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 3 .1 3.3.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 24 12.5 12 12 0 0 0 12 .5z"
            ></path>
          </svg>
          {tertiary.label}
        </a>
      </div>

      <div class="status-badge">
        <span class="dot"></span>
        <span>{statusBadge}</span>
      </div>

      <WaitlistForm client:load {...waitlistCopy} />
    </div>

    <HeroCodeBlock filename={cueFilename} snippet={cueSnippet} />
  </Container>
</section>

<script>
  const btn = document.getElementById('waitlist-toggle');
  if (btn) {
    btn.addEventListener('click', () => {
      const next = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(next));
      document.dispatchEvent(new CustomEvent('waitlist:toggle', { detail: next }));
    });
  }
</script>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 112px;
  }
  .hero :global(.hero-grid) {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 72px;
    align-items: center;
  }
  h1 :global(.accented) {
    color: var(--accent);
  }
  .subhead {
    color: var(--fg-muted);
    font-size: 19px;
    line-height: 1.5;
    margin-top: 24px;
    max-width: 560px;
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  /* Buttons — design-source/styles.css :182-217. */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.005em;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 150ms ease;
    white-space: nowrap;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }
  .btn-primary:hover {
    background: var(--accent-2);
    border-color: var(--accent-2);
  }
  .btn-secondary {
    background: transparent;
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .btn-secondary:hover {
    border-color: var(--fg);
  }
  .btn-text {
    background: transparent;
    color: var(--fg-muted);
    padding: 0 8px;
    height: 44px;
  }
  .btn-text:hover {
    color: var(--fg);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-faint);
    letter-spacing: 0.01em;
  }
  .status-badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  @media (max-width: 1080px) {
    .hero :global(.hero-grid) {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
