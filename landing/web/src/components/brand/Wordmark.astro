import { getSiteSettings } from '../../lib/cms';

type Props = {
  variant?: 'twoTone' | 'mono';
};

const { variant = 'twoTone' } = Astro.props;

const settings = await getSiteSettings();
const accent = settings.brandNameAccent;
const prefix = settings.brandName.endsWith(accent)
  ? settings.brandName.slice(0, settings.brandName.length - accent.length)
  : settings.brandName;
---

{
  variant === 'mono' ? (
    <span class="wordmark">{settings.brandName}</span>
  ) : (
    <span class="wordmark">
      {prefix}
      <span class="accented">{accent}</span>
    </span>
  )
}

<style>
  .wordmark {
    display: inline-flex;
    gap: 0;
  }
  .wordmark .accented {
    color: var(--accent);
  }
</style>
