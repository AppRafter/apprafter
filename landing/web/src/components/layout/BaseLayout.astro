---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Single source for <html> / <head> / <body> shell. Every page
// (index, privacy, terms, [...slug]) passes title + description +
// optional canonical and ogImage. The `head` slot lets pages add
// page-specific tags (JSON-LD on index, robots meta on legal,
// etc.) without overriding the defaults.

import '../../styles/index.css';
import { assetExists, assetVersion } from '../../lib/asset-version';
import { getSiteSettings } from '../../lib/cms';
import { THEME_INIT_SCRIPT } from '../../lib/theme-init';

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
};

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-image.png',
} = Astro.props;

// Content-hash `?v=` busts Cloudflare's edge cache + the browser favicon
// cache the moment an icon's bytes change (see lib/asset-version.ts).
const faviconIco = `/favicon.ico?v=${assetVersion('favicon.ico')}`;
const faviconSvg = `/favicon.svg?v=${assetVersion('favicon.svg')}`;
const favicon16 = `/favicon-16.png?v=${assetVersion('favicon-16.png')}`;
const appleTouchIcon = `/apple-touch-icon.png?v=${assetVersion('apple-touch-icon.png')}`;

// Version local og images too — but only when the file is actually present
// (icons above are required and fail loudly; the og image is optional, so a
// missing one must not break the build). External/absolute URLs pass through.
// Strip any query/hash before the filesystem lookup, and append v= with the
// right separator whether or not the URL already carries a query.
const ogPath = ogImage.startsWith('/') ? ogImage.slice(1).split(/[?#]/)[0] : null;
const ogImageVersioned =
  ogPath && assetExists(ogPath)
    ? `${ogImage}${ogImage.includes('?') ? '&' : '?'}v=${assetVersion(ogPath)}`
    : ogImage;
const ogImageAbs = new URL(ogImageVersioned, Astro.site ?? Astro.url).href;

const settings = await getSiteSettings();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={settings.brandName} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" href={faviconIco} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />

    <link
      rel="preload"
      href="/fonts/roboto-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline set:html={THEME_INIT_SCRIPT} />

    {/* Privacy-friendly analytics by Plausible (site: apprafter.dev). */}
    {/* is:inline keeps Astro from bundling/hoisting these — the loader must */}
    {/* stay verbatim and the init queue must run before the async script lands. */}
    <script
      is:inline
      async
      src="https://plausible.io/js/pa-ObkWGtUzPqv9gmVcgCKLF.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
      plausible.init =
        plausible.init ||
        function (i) {
          plausible.o = i || {};
        };
      plausible.init();
    </script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>
    <slot />
  </body>
</html>
