---
// SPDX-FileCopyrightText: 2026 AppRafter contributors
// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Single source for <html> / <head> / <body> shell. Every page
// (index, privacy, terms, [...slug]) passes title + description +
// optional canonical and ogImage. The `head` slot lets pages add
// page-specific tags (JSON-LD on index, robots meta on legal,
// etc.) without overriding the defaults.

import '../../styles/index.css';
import { THEME_INIT_SCRIPT } from '../../lib/theme-init';

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
};

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-image.png',
} = Astro.props;
const ogImageAbs = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content="AppRafter" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/roboto-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline set:html={THEME_INIT_SCRIPT} />

    {/* Privacy-friendly analytics by Plausible (site: apprafter.dev). */}
    {/* is:inline keeps Astro from bundling/hoisting these — the loader must */}
    {/* stay verbatim and the init queue must run before the async script lands. */}
    <script
      is:inline
      async
      src="https://plausible.io/js/pa-ObkWGtUzPqv9gmVcgCKLF.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
      plausible.init =
        plausible.init ||
        function (i) {
          plausible.o = i || {};
        };
      plausible.init();
    </script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>
    <slot />
  </body>
</html>
