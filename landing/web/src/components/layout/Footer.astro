// SPDX-License-Identifier: FSL-1.1-Apache-2.0

import Brand from '../brand/Brand.astro';
import { getFooterContent, renderCopyright } from '../../lib/cms';
import Container from '../primitives/Container.astro';

const footer = await getFooterContent();
const copyright = renderCopyright(footer.copyright);
const columns = footer.columns ?? [];
---

<footer class="site-footer">
  <Container>
    <div class="footer-grid">
      <div class="footer-brand">
        <Brand variant="twoTone" size={22} />
        <p class="desc">{footer.brandDesc}</p>
      </div>
      {
        columns.map((col) => (
          <div>
            <h4>{col.heading}</h4>
            <ul>
              {(col.links ?? []).map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { target: '_blank', rel: 'noreferrer' } : {})}
                  >
                    {link.label}
                    {link.soon && (
                      <span class="faint mono" style="font-size: 10px; margin-left: 6px;">
                        SOON
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span>{copyright}</span>
      <span class="mono" style="font-size: 12px;">{footer.licenseNote}</span>
      <span>{footer.founderNote}</span>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding: 72px 0 36px;
    font-size: 14px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-grid h4 {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
    margin-bottom: 16px;
  }
  .footer-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .footer-grid a {
    color: var(--fg-muted);
  }
  .footer-grid a:hover {
    color: var(--fg);
  }
  .footer-brand .desc {
    color: var(--fg-muted);
    margin-top: 12px;
    max-width: 280px;
    line-height: 1.55;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--fg-faint);
    font-size: 13px;
    flex-wrap: wrap;
  }

  @media (max-width: 1080px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
