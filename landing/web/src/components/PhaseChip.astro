// SPDX-License-Identifier: FSL-1.1-Apache-2.0
//
// Renders a roadmap-phase chip from the canonical registry
// (src/data/phases.json). Pass the STABLE id; the display label and
// the anchor both come from the registry, so a renumber changes what
// people read, not what they subscribed to. Generalises the
// Advantages `.phase-tag` visual — it does NOT replace those Today:
// chips (Part 4 of the presentation design spec).
//
// The chip's box model is NOT here. It lives in src/styles/global.css
// as `.phase-chip, .phase-ref`, shared with the class CMS-authored HTML
// uses — a scoped component style is emitted behind a
// `data-astro-cid-*` attribute that `set:html` content never carries,
// so scoping it would silently un-style every phase reference written
// in the CMS.

import phaseRegistry from '../data/phases.json';

type Props = { id: string };

const { id } = Astro.props;
const entry = phaseRegistry.phases.find((p) => p.id === id);
if (!entry) {
  throw new Error(
    `[PhaseChip] unknown phase id "${id}" — must be one of ${phaseRegistry.phases
      .map((p) => p.id)
      .join(', ')}`,
  );
}
---

<a class="phase-chip" href={entry.anchor} data-phase-id={entry.id}>{entry.label}</a>

