# Copy to .env and fill in.

# Required — a 32+ character random string used to sign Payload's
# JWTs and cookies. Generate with:  openssl rand -base64 48
PAYLOAD_SECRET=

# Required — Postgres connection. Default matches docker-compose.yml.
DATABASE_URI=postgres://apprafter:apprafter_dev@localhost:5432/apprafter_cms

# Port where Next.js (Payload host) listens for `bun run dev` and
# `bun run start`. Default: 3000. The Astro dev-server's /api proxy
# target derives from this same env (see web/.env.example).
LANDING_CMS_PORT=3000

# Used by Payload for absolute URLs (admin links, REST API base,
# email templates, etc.). When unset, defaults to
# http://localhost:${LANDING_CMS_PORT}. Override in production
# (e.g. https://cms.apprafter.dev).
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Comma-separated CORS allowlist. When unset, defaults to
# http://localhost:${LANDING_WEB_PORT},
# http://localhost:${LANDING_WEB_PREVIEW_PORT},
# https://apprafter.dev — so the local web + preview pair work
# out of the box. Override to add additional origins (ngrok, etc.).
# LANDING_CMS_CORS_ORIGINS=http://localhost:4321,http://localhost:4322,https://apprafter.dev

# SMTP — used by the WaitlistSignups afterChange hook to send a
# Calendly link when wantsCall=true. Leave empty in dev; the hook
# logs a warning and skips sending when SMTP_HOST is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@apprafter.dev
