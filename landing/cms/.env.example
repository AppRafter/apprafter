# Copy to .env and fill in.

# Required — a 32+ character random string used to sign Payload's
# JWTs and cookies. Generate with:  openssl rand -base64 48
PAYLOAD_SECRET=

# Required — Postgres connection. Default matches docker-compose.yml.
DATABASE_URI=postgres://apprafter:apprafter_dev@localhost:5432/apprafter_cms

# Used by Payload for absolute URLs (admin links, REST API base, etc.).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# SMTP — used by the WaitlistSignups afterChange hook to send a
# Calendly link when wantsCall=true. Leave empty in dev; the hook
# logs a warning and skips sending when SMTP_HOST is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@apprafter.dev
