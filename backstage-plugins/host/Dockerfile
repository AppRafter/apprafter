# SPDX-License-Identifier: MIT
# AppRafter tier-1 reference Dockerfile for Backstage host apps
# generated by `@backstage/create-app`. Multi-stage: build with the
# full Node toolchain, run on a minimal slim image.
#
# Node 24 LTS, pinned to the MAJOR -- the one deliberate exception to
# the AppRafter tree's "pin the minor, let the patch float" rule
# (mise.toml's `node` and the `image-node` entry of
# scripts/upstream-pins.json track this line). Node ships every fix,
# security releases included (24.13.0 and 24.17.0 were new minors), on
# the newest minor of the line and never patches an older one, so a
# minor pin would be an exact pin. Keep both FROM lines on the same
# major. The major is bounded by Backstage, which supports exactly two
# adjacent LTS majors: see `engines.node` in the generated app's
# package.json.

# ---- builder ---------------------------------------------------
FROM node:24-bookworm-slim AS build

WORKDIR /app

# Install OS deps Backstage's native modules need at build time
# (sqlite3, libpq-headers when @backstage/plugin-catalog-backend
# pulls pg). Slim down once with --no-install-recommends.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      python3 \
      libsqlite3-dev \
      libpq-dev \
 && rm -rf /var/lib/apt/lists/*

# Copy lockfiles first so the dep-install layer caches across
# source-only edits.
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
RUN corepack enable \
 && yarn install --immutable

# Now the source.
COPY . .

# Type-check then bundle the backend. `yarn build:backend` produces
# packages/backend/dist/{skeleton,bundle}.tar.gz which the runtime
# stage extracts.
RUN yarn tsc \
 && yarn build:backend

# ---- runtime ---------------------------------------------------
FROM node:24-bookworm-slim

# Native modules at runtime (sqlite3 if you stay on the default
# config; libpq for Postgres).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libsqlite3-0 \
      libpq5 \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Skeleton = workspace package.json + yarn lock + .yarn/. Bundle =
# the actual built code.
COPY --from=build /app/yarn.lock /app/package.json /app/packages/backend/dist/skeleton.tar.gz ./
RUN tar xzf skeleton.tar.gz \
 && rm skeleton.tar.gz \
 && corepack enable \
 && yarn workspaces focus --all --production \
 && rm -rf "$(yarn cache dir)"

COPY --from=build /app/packages/backend/dist/bundle.tar.gz ./
RUN tar xzf bundle.tar.gz && rm bundle.tar.gz

# app-config.yaml is the operator's; `@backstage/create-app` puts
# it at the repo root so this COPY needs no rename.
COPY app-config.yaml ./

# Backstage default port. Match the Service.targetPort in the
# manifest set generated by k8s::backstage_manifests.
EXPOSE 7007

# Run as the unprivileged `node` user already provided by the
# upstream node images. NetworkPolicy default-deny (v0.1.12) means
# the pod can't egress without an explicit allow rule, so this is
# defence-in-depth.
USER node

CMD ["node", "packages/backend", "--config", "app-config.yaml"]
