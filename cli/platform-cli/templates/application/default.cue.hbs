package apprafter

import v1alpha1 "apprafter.io/schemas/v1alpha1"

{{app_name_camel}}: v1alpha1.#Application & {
	metadata: {
		// DNS-1123 lowercase. Free to rename — the scaffold
		// pulls this from the directory you ran `apprafter
		// app scaffold` in.
		name: "{{app_name}}"

		// Namespace the AppRafter operator watches and
		// where Argo CD applies the rendered Deployment +
		// Service. Matches the default `apprafter app add
		// --namespace` value; override if you've carved
		// out a tenant-specific namespace.
		namespace: "{{namespace}}"

		labels: {
			"apprafter.io/runtime":   "{{runtime_slug}}"
			"apprafter.io/component": "user-app"
		}
	}

	spec: base: {
		{{image_comment}}
		image: "{{image_placeholder}}"

		// Start with a single replica; scale once you have
		// observed load. The operator handles rolling
		// updates automatically.
		replicas: 1

		expose: {
			// Container port the {{runtime_display}} app
			// listens on. Defaults to {{primary_port}} for
			// {{runtime_display}} apps; override if your
			// process binds elsewhere.
			port: {{primary_port}}

			// Internal-only by default (a ClusterIP Service). To
			// expose publicly, uncomment `network: "public"` and add
			// a `hostname` (a single host or a list) under one of the
			// cluster's registered allowedDomains zones; the operator
			// then renders the Gateway-API HTTPRoute automatically.
			// network:  "public"           // also "internal" (default) / "vpn"
			// hostname: "app.example.com"  // required when network: public
		}

		// Health checks. Without a `readiness` block the platform
		// still waits for something to accept a TCP connection on
		// the port above before sending traffic — point these at
		// your own endpoints to check more than that. Every timing
		// has a default (10s period, 2s timeout, 3 failures), so a
		// path is enough to start.
		//
		// probes: {
		//     readiness: path: "/health"
		//     liveness:  path: "/health"
		// }{{needs_block}}

		// Environment variables. A value is a literal string, a
		// reference to a declared dependency's connection secret
		// (`claim.<type>.<field>`), or a reference to a secret you
		// sealed yourself (`secret: "<name>/<key>"`). Uncomment and
		// replace placeholders when needed:
		//
		// env: {
		//     "LOG_LEVEL":    "info"
		//     "APP_PORT":     "{{primary_port}}"
		//     "DATABASE_URL": claim.pg.url
		// }
	}

	// Per-environment overrides. The environment is chosen at
	// deploy time (`apprafter app add --env dev`) and its block
	// deep-merges onto `spec.base`, field by field — so an
	// environment carries only its diff and inherits the rest.
	// Uncomment and tune as you grow beyond a single environment:
	//
	// spec: environments: {
	//     dev: {
	//         replicas: 1
	//         probes: readiness: periodSeconds: 3
	//     }
	//     prod: {
	//         replicas: 3
	//         // expose: network: "public"
	//     }
	// }
}
