# Editors / IDE
.idea/
.vscode/
*.swp
*.swo

# Local Claude Code state (per-user)
CLAUDE.md
.claude/
docs/superpowers

# Node / Bun / TypeScript
node_modules/
.bun/
bun.lockb
*.tsbuildinfo
dist/
out/
.next/

# Rust
target/
**/*.rs.bk
*.pdb

# CUE
cue.out/

# MkDocs build output
site/

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Logs / coverage / temp
*.log
coverage/
.nyc_output/
.cache/
tmp/
.tmp/

# Local env / secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
!**/age.pub.key

# Local apprafter state (.apprafter/) — never commit raw, only age-encrypted blobs
**/.apprafter/*
!**/.apprafter/*.age

# Root-level Markdown: allowlist only. Internal working / strategy notes
# (marketing-strategy.md, speedrun-plan.md, *-task.md, *_CHECKLIST.md,
# refactor-plan.md, idiomatic-rust-audit.md, …) stay local-only and must
# never be committed. To publish a new root doc, add an explicit negation.
# (CLAUDE.md stays ignored via the per-user entry above.)
/*.md
!/README.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/GOVERNANCE.md
!/SECURITY.md
!/spec.md
!/plan.md
