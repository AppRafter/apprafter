# Editors / IDE
.idea/
.vscode/
*.swp
*.swo

# Local Claude Code state (per-user)
CLAUDE.md
.claude/
docs/superpowers

# Node / Bun / TypeScript
node_modules/
.bun/
bun.lockb
*.tsbuildinfo
dist/
out/
.next/

# Rust
target/
**/*.rs.bk
*.pdb

# CUE
cue.out/

# Python — the MkDocs build hooks under docs/hooks/ are the only Python
# source here, and importing them leaves a __pycache__ beside them.
# Without this, a `git add docs` picks it up (mkdocs.yml already keeps
# it out of the built site, which is a different problem).
__pycache__/
*.py[cod]

# MkDocs build output. The pattern has no leading or interior slash, so
# git applies it at every level: it covers both the repo-root `site/`
# that a bare `mkdocs build` writes and `docs-site/site/`, which the
# release workflow builds into the image's context. Verify rather than
# assume, before adding a second rule:
#
#   git check-ignore -v docs-site/site/index.html
site/

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Logs / coverage / temp
*.log
coverage/
.nyc_output/
.cache/
tmp/
.tmp/

# Local env / secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
!**/age.pub.key
# Test-only TLS key fixtures for cli-providers cert parsing (1.83e) — not real secrets.
!cli/cli-providers/tests/fixtures/*.key

# Local apprafter state (.apprafter/) — never commit raw, only age-encrypted blobs
**/.apprafter/*
!**/.apprafter/*.age

# Root-level Markdown: allowlist only. Internal working / strategy notes
# (marketing-strategy.md, speedrun-plan.md, *-task.md, *_CHECKLIST.md,
# refactor-plan.md, idiomatic-rust-audit.md, …) stay local-only and must
# never be committed. To publish a new root doc, add an explicit negation.
# (CLAUDE.md stays ignored via the per-user entry above.)
/*.md
!/README.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/GOVERNANCE.md
!/SECURITY.md
!/spec.md
!/plan.md
!/FEATURE_TRACKER.md
# Written by ATM's changelog sync, not by hand — see the note at its top.
!/CHANGELOG.md

# scratch docs accidentally swept by a subagent git add -A (2026-06-10)
/landing/docs/steps.md

/backup-test.env

# --- ATM (AgentTaskManager) ---------------------------------------------------
# Added by the ATM Claude pack. Everything else in this file is yours and is left
# alone; these two lines are appended only if they are not already here.

# Per-session state the discipline hooks write (one file per Claude Code session,
# plus a lock and scratch files). Pruned at session start, never useful to commit —
# and committing it is actively harmful: `git add -A` sweeps the current session's
# file into a branch, and checking another branch out then DELETES it, which leaves
# the stop gate judging the turn against no baseline at all.
.claude/.atm/

# The ATM project token. This is the one place the credential lives, and it reaches
# both the MCP client and the discipline hooks. It must never be committed — unlike
# .claude/settings.json, which this pack installs and which IS meant to be shared.
.claude/settings.local.json
